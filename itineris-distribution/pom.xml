<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.forwardmeasure</groupId>
        <artifactId>itineris</artifactId>
        <version>1.1.0</version>
    </parent>

    <artifactId>itineris-distribution</artifactId>
    <name>Itineris-Distribution</name>
    <description>
        Distribution module for Itineris. Produces filtered shell scripts (Maven
        property tokens resolved), collects runtime dependencies, and provides the
        build context for the Docker image. This module depends on all runtime
        modules so that dependency:copy-dependencies produces a complete lib/ directory.
    </description>

    <dependencies>
        <!-- ================================================================
             Itineris modules — all runtime modules needed in the Docker image
             ================================================================ -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>itineris-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>itineris-server</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>itineris-config</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>itineris-cql</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>itineris-opensearch</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>itineris-inmemory</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>itineris-berkeleyje</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>itineris-mixed-index-utils</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>itineris-driver</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>itineris-grpc</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>itineris-hadoop</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>cassandra-hadoop-util</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- ================================================================
             JAMM — javaagent for memory measurement, referenced in
             itineris-server.sh as -javaagent:.../jamm-${jamm.version}.jar
             Must be runtime scope so it ends up in lib/
             ================================================================ -->
        <dependency>
            <groupId>com.github.jbellis</groupId>
            <artifactId>jamm</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- ================================================================
             Resource filtering — resolves Maven property tokens in shell
             scripts (e.g. ${jamm.version} → 0.4.0) and writes filtered
             output to target/bin/ and target/conf/
             ================================================================ -->
        <resources>
            <resource>
                <directory>bin</directory>
                <targetPath>${project.build.directory}/bin</targetPath>
                <filtering>true</filtering>
                <includes>
                    <include>*.sh</include>
                </includes>
            </resource>
            <resource>
                <directory>conf</directory>
                <targetPath>${project.build.directory}/conf</targetPath>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>docker</directory>
                <targetPath>${project.build.directory}/docker</targetPath>
                <filtering>false</filtering>
            </resource>
        </resources>

        <plugins>
            <!-- ============================================================
                 Copy all runtime dependencies to target/lib/ so
                 build-itineris-image.sh can use them directly without
                 invoking Maven at image build time.
                 ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-runtime-dependencies</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <useRepositoryLayout>false</useRepositoryLayout>
                            <overWriteReleases>false</overWriteReleases>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- ============================================================
                 Set executable bit on filtered shell scripts
                 ============================================================ -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>chmod-scripts</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <chmod file="${project.build.directory}/bin/itineris-server.sh" perm="755"/>
                                <chmod file="${project.build.directory}/bin/itineris.sh" perm="755"/>
                                <chmod file="${project.build.directory}/docker/docker-entrypoint.sh" perm="755"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
